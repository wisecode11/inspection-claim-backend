PORT=8000
MONGODB_URI=mongodb://127.0.0.1:27017/backend-roofing
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Geocoding (job create). auto = Google if key, else Mapbox if token, else OpenStreetMap.
GEOCODE_PROVIDER=auto
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=
GEOCODE_USER_AGENT=RoofCheck/1.0
