PORT=8000
MONGODB_URI=mongodb://127.0.0.1:27017/backend-roofing
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
CORS_ORIGIN=http://localhost:3000
PLATFORM_ADMIN_EMAIL=admin@gmail.com
PLATFORM_ADMIN_PASSWORD=11223344

# Google Sign-In (company admin). Use the OAuth 2.0 Web Client ID from
# Firebase Auth → Google provider, or Google Cloud Console → Credentials.
# Comma-separate multiple client IDs (web + mobile) if needed.
GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_IDS=web-client-id.apps.googleusercontent.com

# Geocoding (job create). auto = Google if key, else Mapbox if token, else OpenStreetMap.
GEOCODE_PROVIDER=auto
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=
GEOCODE_USER_AGENT=RoofCheck/1.0

# Historical weather for date of loss (Open-Meteo, no key). Hail Trace can replace later.
WEATHER_PROVIDER=open_meteo
WEATHER_WINDOW_DAYS=1
WEATHER_CACHE_TTL_HOURS=24

# Gmail SMTP (use an App Password, not the Google account password).
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=RoofClaim
EMAIL_REPLY_TO=
